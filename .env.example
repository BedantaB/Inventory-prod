# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.
# Where to find each value is explained in README.md ("Get your Supabase keys").

# --- Supabase project (Dashboard → Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable key" (starts with sb_publishable_). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# "Secret key" (starts with sb_secret_). SERVER ONLY — used to create staff logins and upload photos.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Database (Dashboard → Connect → ORMs / Connection string) ---
# Transaction pooler (port 6543) — used by the running app.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Session pooler (port 5432) — used by migrations and the seed script.
MIGRATION_DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- App ---
# Public URL of the app (used in "forgot password" emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Staff log in with a username; behind the scenes it becomes username@STAFF_EMAIL_DOMAIN.
STAFF_EMAIL_DOMAIN=staff.inventory.app

# Printed at the top of every order (all optional).
BUSINESS_NAME=Your Shop Name
BUSINESS_ADDRESS=Shop address, City
BUSINESS_PHONE=98xxxxxxxx

# --- Seed script only (pnpm db:seed) ---
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=change-me-please
SEED_STAFF_PASSWORD=staff-pass-123
